{
  "name": "dsh-armor-lite",
  "version": "0.6.0",
  "description": "轻量提示词增强：只追加不改写（执行契约段）+ 人设库 + 规则层分离 + 拒答恢复 + 侧栏管理面板；改写层降为可选开关",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "selftest": "node tools/selftest.mjs",
    "lint:persona": "node tools/persona-lint.mjs --legacy"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "strip-rules.js",
    "refusal-recover.js",
    "cordis.patch.yml",
    "personas"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
