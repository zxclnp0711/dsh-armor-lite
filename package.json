{
  "name": "dsh-armor-lite",
  "version": "0.4.1",
  "description": "轻量破甲：YAML 权限层 + 运行时系统提示词改写 + 多套人设库（含硬约束片段与最小插值）+ 本地规则 + 拒答恢复 + 侧栏破甲面板",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "selftest": "node tools/selftest.mjs",
    "lint:persona": "node tools/persona-lint.mjs --legacy"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "strip-rules.js",
    "refusal-recover.js",
    "cordis.patch.yml",
    "personas"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "private": true
}
